# ─────────────────────────────────────────────────────────────
# EAS Industrial Copilot — environment
# Copy to .env.local and fill in. The app runs WITHOUT any keys
# (demo mode + local file storage); add keys to go live & persistent.
# ─────────────────────────────────────────────────────────────

# ── AI ───────────────────────────────────────────────────────
# Anthropic Claude (primary reasoning engine). Get one at console.anthropic.com
# Leave blank to run in deterministic fallback mode. See AI_PROVIDER_SETUP.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── AI cost controls ─────────────────────────────────────────
# Model tiering: known fault-code questions are answered deterministically (no
# LLM cost); normal troubleshooting uses Sonnet; only complex engineering / PLC /
# RCA / multi-document reasoning uses Opus (ANTHROPIC_MODEL above).
AI_MODEL_SONNET=claude-sonnet-4-5
# Global kill switch — set to 1 to force deterministic fallback everywhere
# (e.g. if spend spikes). Surfaced in /api/health and the admin AI panel.
AI_KILL_SWITCH=0
# Optional global ceiling on AI questions per org per month. 0/blank = use the
# org's PLAN quota (Pilot 1,000 · Professional 5,000 · Multi-Site 20,000).
# A non-zero value can only LOWER a plan's cap, never raise it.
AI_MONTHLY_QUESTIONS_PER_ORG=
# Estimated model prices (USD per 1M tokens) for cost reporting — override if the
# list price changes. Defaults: Opus 15/75, Sonnet 3/15 (input/output).
AI_PRICE_OPUS_IN=
AI_PRICE_OPUS_OUT=
AI_PRICE_SONNET_IN=
AI_PRICE_SONNET_OUT=

# ── Billing / plans (Stripe) ─────────────────────────────────
# Stripe secret + webhook signing secret (Manus configures on the VM).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map Stripe PRICE ids to internal plan codes (pilot/professional/multisite/
# enterprise). Set after creating the products/prices in the Stripe dashboard.
STRIPE_PRICE_PILOT=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_MULTISITE=
STRIPE_PRICE_ENTERPRISE=
# Optional per-plan quota overrides for the CONFIGURABLE tiers (Multi-Site,
# Enterprise). Users are a count; storage is GB. e.g.:
#   PLAN_USERS_MULTI_SITE=250   PLAN_STORAGE_GB_ENTERPRISE=2000
PLAN_USERS_MULTI_SITE=
PLAN_STORAGE_GB_MULTI_SITE=
PLAN_USERS_ENTERPRISE=
PLAN_STORAGE_GB_ENTERPRISE=

# ── Database ─────────────────────────────────────────────────
# Default is a local file (zero setup) — fine for local dev, but NOT durable on
# ephemeral / serverless hosting (Manus, containers w/o a disk).
# For durable hosting, use a hosted libSQL/Turso database:
#   DATABASE_URL=libsql://<your-db>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create`>
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ── File storage (uploaded originals) ────────────────────────
# If these S3-compatible vars are set, uploaded files go to the bucket;
# otherwise they fall back to the local ./uploads folder (not durable on
# ephemeral hosting). Works with Cloudflare R2, AWS S3, Backblaze B2, MinIO.
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_REGION=us-east-1
# Required for R2 / B2 / MinIO (omit for AWS S3):
STORAGE_S3_ENDPOINT=
# Set "true" for R2 / MinIO path-style addressing:
STORAGE_S3_FORCE_PATH_STYLE=

# ── Auth / RBAC ──────────────────────────────────────────────
# Login is MANDATORY BY DEFAULT. With everything below unset, this is the real,
# EMPTY Production Workspace and sign-in is enforced across the app — the first
# visitor creates the owner account at /login. Explicit override (either way):
#   AUTH_REQUIRED=true   → always enforce sign-in
#   AUTH_REQUIRED=false  → run open (no login)   [use with care]
AUTH_REQUIRED=
# Demo (sales) mode — the ONLY open-by-default path. Serves the ISOLATED Demo
# Organization (seeded Conveyor 3 / PowerFlex dataset) with no login friction.
# Real customer data is never in this tenant. Enable with either:
#   DEMO_MODE=true   (preferred)   or   OPEN_MODE_ORG=demo
DEMO_MODE=
OPEN_MODE_ORG=
# Deliberately run the REAL workspace open on a single-user local box. /api/health
# then reports security.insecureOpenProduction=true so monitors can catch it.
ALLOW_INSECURE_OPEN_PRODUCTION=
# Base URL of this deployment (used to build the OIDC redirect URI).
APP_BASE_URL=

# ── Enterprise SSO (OIDC) ────────────────────────────────────
# Works with Okta, Auth0, Microsoft Entra ID, Google Workspace, Ping, etc.
# Redirect/callback URL to register at your IdP: <APP_BASE_URL>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Role assigned to first-time SSO users (owner|admin|manager|technician|viewer):
OIDC_DEFAULT_ROLE=technician

# ── Live connectors (optional) ───────────────────────────────
# Set a connector's API key to switch it from sandbox to live.
# Convention: <CONNECTOR>_API_KEY. Implemented live today: MaintainX.
MAINTAINX_API_KEY=
# MAINTAINX_BASE_URL=https://api.getmaintainx.com/v1

# ── Observability ────────────────────────────────────────────
# Structured JSON logs. Level: debug|info|warn|error (default info; warn in test).
LOG_LEVEL=info
# Surfaced by /api/health as the running version.
APP_VERSION=1.0.0

# ── Security headers ─────────────────────────────────────────
# Opt-in Content-Security-Policy. Validate against your build before enabling in
# production — a strict CSP can break inline runtime if misconfigured.
CSP_ENABLED=
# Extra origins to allow in the CSP connect-src (space-separated https URLs).
CSP_CONNECT_SRC=

# ── Rate limiting (optional overrides) ───────────────────────
# Per-instance, in-memory. Auth defaults to 10 req / 60s per IP; the public API
# to 60 req / 60s per API key. Override without code changes:
RL_AUTH_LIMIT=10
RL_AUTH_WINDOW_SEC=60
RL_PUBLIC_API_LIMIT=60
RL_PUBLIC_API_WINDOW_SEC=60
